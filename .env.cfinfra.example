# .env.cfinfra.example — template for .env.cfinfra (committed, no real values).
#
# Consumed by apps/web/scripts/gen-wrangler.mjs to fill ${TOKEN} placeholders
# in apps/web/wrangler.template.jsonc. Copy to .env.cfinfra at the repo root
# (gitignored) or put the same keys in apps/web/.env.local.
#
# Staging deploy needs the three remote D1 ids. Create them once:
#   wrangler d1 create claudecommunity-registry-staging
#   wrangler d1 create claudecommunity-sydney-staging
#   wrangler d1 create claudecommunity-melbourne-staging
# then paste each database_id below.

CLOUDFLARE_ACCOUNT_ID=
REGISTRY_DATABASE_ID=
TENANT_SYDNEY_DATABASE_ID=
TENANT_MELBOURNE_DATABASE_ID=

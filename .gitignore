# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
**/artifacts/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.*.example

# typescript
*.tsbuildinfo

nul
*.db
*.db-journal

DATABASE.md

# Cloudflare
.wrangler
.dev.vars
# Generated by apps/web/scripts/gen-wrangler.mjs (per-deployment account/resource ids).
apps/web/wrangler.jsonc

# apps/web local install (independent lockfile)
apps/web/node_modules/

# Claude Code
.claude/worktrees

# Agent session handovers (written by ~/.claude/hooks/save-handover.py)
.handover/

# mcp-ui generated artifacts
/mcp-ui/dist/
/mcp-ui/node_modules/

# clerk configuration (can include secrets)
/.clerk/

# Phase-0 multi-tenancy W4P spike (throwaway prototype)
spike/

# mobile (Capacitor/Android) — local-only experiment
/mobile/

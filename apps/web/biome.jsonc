{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/tanstack"
  ],
  "files": {
    "includes": [
      "!**/node_modules",
      "!**/.wrangler",
      "!**/dist",
      "!**/routeTree.gen.ts",
      "!**/worker-configuration.d.ts",
      "!**/drizzle/**/*.sql"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "includes": [
        "src/modules/**/repositories/**",
        "src/shared/db/**",
        "src/workflows/**",
        "src/worker-scheduled.ts",
        "src/server.ts",
        "test/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off",
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["src/modules/**/*.ts", "src/shared/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/modules/activity/**",
        "!src/modules/activity/repositories/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/modules/*/repositories/**",
                      "!@/modules/activity/repositories/**"
                    ],
                    "message": "Cross-module repository import. Go through that module's service layer instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/modules/attendance/**",
        "!src/modules/attendance/repositories/**"
      ],

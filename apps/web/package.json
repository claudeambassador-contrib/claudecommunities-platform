{
  "name": "@claudecommunities/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "deploy:staging": "bun run gen:wrangler && bun run build && wrangler deploy --env staging",
    "gen:wrangler": "node scripts/gen-wrangler.mjs",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome check . && bun run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:iso": "vitest run test/iso",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "db:migrate:registry:local": "wrangler d1 migrations apply REGISTRY --local --config wrangler.jsonc",
    "db:migrate:tenant:local": "node scripts/migrate-tenant-local.mjs",
    "db:provision:city": "node scripts/provision-city.mjs",
    "db:seed:city": "bun scripts/seed-city.ts",
    "db:seed:e2e-admin": "bun scripts/seed-e2e-admin.ts",
    "postinstall": "true"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.5.2",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@remotion/player": "^4.0.512",
    "@tanstack/react-router": "^1.170.29",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-start": "^1.168.46",
    "drizzle-orm": "^0.44.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "remotion": "^4.0.512",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@clerk/testing": "^2.2.24",
    "@cloudflare/vite-plugin": "^1.29.0",
    "@cloudflare/workers-types": "^4.20250817.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "better-sqlite3": "^12.6.2",
    "drizzle-kit": "^0.31.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.8.0",
    "ultracite": "^7.10.5",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.6",
    "wrangler": "^4.88.0"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@clerk/shared",
    "better-sqlite3",
    "esbuild",
    "sharp",
    "workerd"
  ]
}

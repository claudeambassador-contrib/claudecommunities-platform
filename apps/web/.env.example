# Clerk (TanStack Start uses VITE_ prefix for publishable key)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Region deploy knob (au | nz) — branding only, not tenant isolation
VITE_REGION=au

# Maintenance
MAINTENANCE_MODE=false
MAINTENANCE_BYPASS_TOKEN=

# Cloudflare infra (local/staging) — see .env.cfinfra.example at repo root
CLOUDFLARE_ACCOUNT_ID=
REGISTRY_DATABASE_ID=
TENANT_SYDNEY_DATABASE_ID=
TENANT_MELBOURNE_DATABASE_ID=

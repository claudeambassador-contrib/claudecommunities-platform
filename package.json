{
  "name": "claudecommunities-platform",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "Dominik Fretz, Rye Smith, Claude Community Australia",
  "type": "module",
  "scripts": {
    "build": "bun run --cwd apps/web build",
    "check": "bun run --cwd apps/web check",
    "check:fix": "bun run --cwd apps/web lint:fix && bun run --cwd apps/web format",
    "deploy:staging": "bun run --cwd apps/web deploy:staging",
    "dev": "bun run --cwd apps/web dev",
    "format": "bun run --cwd apps/web format",
    "format:check": "bun run --cwd apps/web format:check",
    "lint": "bun run --cwd apps/web lint",
    "prepare": "git config core.hooksPath .githooks || true",
    "preview": "bun run --cwd apps/web preview",
    "test": "bun run --cwd apps/web test",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "test:iso": "bun run --cwd apps/web test:iso",
    "typecheck": "bun run --cwd apps/web typecheck"
  },
  "engines": {
    "node": ">=20.19"
  }
}
